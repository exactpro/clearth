<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
	xmlns:jaxb="http://java.sun.com/xml/ns/jaxb"
    jaxb:version="2.1">
   
   <xsd:complexType name="HttpHeader">
   		<xsd:attribute name="name" type="xsd:string"/>
   		<xsd:attribute name="value" type="xsd:string"/>
	   	<xsd:attribute name="required" type="xsd:boolean" default="false"/>
	    <xsd:attribute name="requestName" type="xsd:string"/>
   </xsd:complexType>

	<xsd:simpleType name="HttpParameterType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="text" />
			<xsd:enumeration value="timestamp" />
			<xsd:enumeration value="integer" />
			<xsd:enumeration value="decimal" />
		</xsd:restriction>
	</xsd:simpleType>
    
   <xsd:complexType name="HttpParameter">
   		<xsd:attribute name="name" type="xsd:string"/>
   		<xsd:attribute name="requestName" type="xsd:string"/>
	    <xsd:attribute name="required" type="xsd:string" default="false">
		   <xsd:annotation>
			   <xsd:appinfo>
				   <jaxb:property name="requiredExpression"/>
			   </xsd:appinfo>
		   </xsd:annotation>
		</xsd:attribute>
	   <xsd:attribute name="defaultValue" type="xsd:string"/>
	   <xsd:attribute name="type" type="HttpParameterType"/>
	   <xsd:attribute name="possibleValues" type="xsd:string"/>
	   <xsd:attribute name="minValue" type="xsd:decimal"/>
	   <xsd:attribute name="maxValue" type="xsd:decimal"/>
	   <xsd:attribute name="precision" type="xsd:int"/>
	   <xsd:attribute name="format" type="xsd:string"/>
	   <xsd:attribute name="delimiter" type="xsd:string"/>
   </xsd:complexType>
   
   <xsd:complexType name="HttpBody">
   		<xsd:attribute name="type" type="BodyType"/>
   		<xsd:attribute name="msgType" type="xsd:string"/>
   		<xsd:attribute name="codec" type="xsd:string"/>
   </xsd:complexType>
   
	<xsd:simpleType name="BodyType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="JSON" />
    		<xsd:enumeration value="XML" />
    		<xsd:enumeration value="SWIFT" />
 		</xsd:restriction>
	</xsd:simpleType>
   
   <xsd:simpleType name="HttpMethod">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="GET"/>
			<xsd:enumeration value="POST"/>
			<xsd:enumeration value="PUT"/>
			<xsd:enumeration value="DELETE"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="HttpCommonParametersLink">
		<xsd:attribute name="reference" type="xsd:string"/>
	</xsd:complexType>

	<xsd:complexType name="HttpQueryParametersBlock">
		<xsd:sequence>
			<xsd:element name="parameter" type="HttpParameter" minOccurs="1" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:appinfo>
						<jaxb:property name="parameters"/>
					</xsd:appinfo>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="commonParameters" type="HttpCommonParametersLink"  minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
		<xsd:attribute name="name" type="xsd:string"/>
	</xsd:complexType>

	<xsd:complexType name="HttpBodyParametersBlock">
		<xsd:sequence>
			<xsd:element name="parameter" type="HttpParameter" minOccurs="1" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:appinfo>
						<jaxb:property name="parameters"/>
					</xsd:appinfo>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="name" type="xsd:string"/>
	</xsd:complexType>
   
   <xsd:complexType name="HttpRequestDesc">
   		<xsd:sequence>
   			<xsd:element name="url" type="xsd:string" minOccurs="1" maxOccurs="1"/> 			
   			<xsd:element name="method" type="HttpMethod" minOccurs="1" maxOccurs="1"/>
   			<xsd:element name="headers" minOccurs="0" maxOccurs="1">
   				<xsd:annotation>
           			<xsd:appinfo>
               			<jaxb:property name="headersBlock"/>
           			</xsd:appinfo>
        		</xsd:annotation>  			
   				<xsd:complexType>
   					<xsd:sequence>
   						<xsd:element name="header" type="HttpHeader" minOccurs="1" maxOccurs="unbounded">
   							<xsd:annotation>
           						<xsd:appinfo>
               						<jaxb:property name="headers"/>
           						</xsd:appinfo>
        					</xsd:annotation>
        				</xsd:element>	
   					</xsd:sequence>
   				</xsd:complexType>
   			</xsd:element>
   			<xsd:element name="pathParameters" minOccurs="0" maxOccurs="1">
   				<xsd:annotation>
           			<xsd:appinfo>
               			<jaxb:property name="pathParametersBlock"/>
           			</xsd:appinfo>
        		</xsd:annotation> 
   				<xsd:complexType>
   					<xsd:sequence>
   						<xsd:element name="parameter" type="HttpParameter" minOccurs="1" maxOccurs="unbounded">
   							<xsd:annotation>
           						<xsd:appinfo>
               						<jaxb:property name="parameters"/>
           						</xsd:appinfo>
        					</xsd:annotation> 
        				</xsd:element>
   					</xsd:sequence>
   				</xsd:complexType>
   			</xsd:element>
   			<xsd:element name="queryParameters" type="HttpQueryParametersBlock" minOccurs="0" maxOccurs="1">
   				<xsd:annotation>
           			<xsd:appinfo>
               			<jaxb:property name="queryParametersBlock"/>
           			</xsd:appinfo>
        		</xsd:annotation>
   			</xsd:element>
   			<xsd:element name="body" type="HttpBody" minOccurs="0" maxOccurs="1"/>
			<xsd:element name="bodyParameters" type="HttpBodyParametersBlock" minOccurs="0" maxOccurs="1">
				<xsd:annotation>
					<xsd:appinfo>
						<jaxb:property name="bodyParametersBlock"/>
					</xsd:appinfo>
				</xsd:annotation>
			</xsd:element>
   		</xsd:sequence>
   		<xsd:attribute name="type" type="xsd:string"/>
   </xsd:complexType>
   
   <xsd:element name="HttpDictionaryDesc">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="requestDesc" type="HttpRequestDesc" minOccurs="1" maxOccurs="unbounded"/>
				<xsd:element name="commonQueryParameters" type="HttpQueryParametersBlock" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>    
</xsd:schema>  